               <id root="4e530cfd-fea6-c5eb-e063-6394a90a5f4a"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Indications</title>
               <text>
                  <paragraph>PRO-SYS Professional is a self-applied dentifrice for prevention of tooth decay, orthodontic decalcification and hypersensitivity.</paragraph>
               </text>
               <effectiveTime value="20251201"/>
            </section>
