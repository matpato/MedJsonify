         <component>
            <section ID="id_link_4e5302ed-0493-acdf-e063-6394a90a74c6">
               <id root="4e5302ed-0492-acdf-e063-6394a90a74c6"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>Do not swallow
  <br/>
For topical use only
  <br/>
As with all medications, keep out of reach of children
 </paragraph>
               </text>
               <effectiveTime value="20251201"/>
            </section>
