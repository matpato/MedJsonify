            <section ID="Section_9">
               <id root="a047f26f-7715-4db9-b31a-3ba188045634"/>
               <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
               <title>OVERDOSAGE</title>
               <text>
                  <paragraph>Topically applied clindamycin phosphate can be absorbed in sufficient amounts to produce systemic effects (see <linkHtml href="#Section_5">WARNINGS</linkHtml>). </paragraph>
               </text>
               <effectiveTime value="20260430"/>
            </section>
         </component>
         <component>
            <section ID="Section_10">
               <id root="fb61c06d-d18e-4d8b-8c8e-22fe51bbb28b"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DOSAGE AND ADMINISTRATION</title>
               <text>
                  <paragraph>Apply a thin film of clindamycin phosphate gel twice daily to affected area.</paragraph>
               </text>
               <effectiveTime value="20260430"/>
            </section>
         </component>
