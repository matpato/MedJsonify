            <section ID="ID_40a6e734-7a9d-4542-862a-26c595f1f565">
               <id root="a0314135-9bad-46ef-824d-d15ff0d01cd0"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>FOR I.V. USE ONLY AFTER DILUTION<br/>Plastic Vial</paragraph>
                  <paragraph>
                     <content styleCode="bold">Rx only</content>
                  </paragraph>
               </text>
