               <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
               <title>OVERDOSAGE</title>
               <text>
                  <paragraph>Topically applied<content styleCode="bold"> Clindacin</content>
                     <sup>®</sup>
                     <content styleCode="bold"> ETZ </content>can be absorbed in sufficient amounts to produce systemic effects (see <content styleCode="bold">
                        <linkHtml href="#WARN">WARNINGS</linkHtml>
                     </content>).</paragraph>
               </text>
               <effectiveTime value="20260402"/>
            </section>
