               <text>
                  <paragraph>NDC: 87500-100-11</paragraph>
                  <paragraph>100 mg Tablet Bottle Label</paragraph>
                  <paragraph>SCEDAMIN
  <sup>TM </sup>(Hydroxyurea)
 </paragraph>
                  <paragraph>100 mg per Tablet</paragraph>
                  <paragraph>For Oral Administration</paragraph>
                  <paragraph>RX Only</paragraph>
                  <paragraph>60 Tablets</paragraph>
