               <id root="7822c64d-f296-42b6-adf7-db4de24ce4f6"/>
               <code code="50741-8" codeSystem="2.16.840.1.113883.6.1" displayName="SAFE HANDLING WARNING SECTION"/>
               <title>
                  <content styleCode="bold">STORAGE:</content>
               </title>
               <text>
                  <paragraph>Store at room
  
       
 
  <br/>
temperature 15°C-30°C
  
       
 
  <br/>
(59°F-86°F).
  
       
 
  <br/>
Protect from freezing.
  
       
 
  <br/>
Keep bottle tightly closed.
 
      

 </paragraph>
               </text>
               <effectiveTime value="20211115"/>
            </section>
         </component>
