            <section ID="LINK_ea2066e4-e04a-412f-8ab4-4e68ebc05069">
               <id root="1f6f5113-6d2e-4f37-90f1-2c3d14bd883f"/>
               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>
                  <content styleCode="bold">Hydravex™</content>
               </title>
               <text>
                  <paragraph>Manufactured in the USA for:
<br/>
                     <content styleCode="bold">Oncora Pharma LLC</content>
