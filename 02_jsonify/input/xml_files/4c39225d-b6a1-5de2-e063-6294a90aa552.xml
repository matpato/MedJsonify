                     <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
                     <title>OTHER INGREDIENTS</title>
                     <text>
                        <paragraph>Bovine Gelatin, Glycerin, Soybean Oil, Soy Lecithin, Purified Water, Yellow Beeswax, FD&amp;C Red # 40, Titanium Dioxide, Orange Cream Flavor, Ethyl Vanillin, FD&amp;C Yellow # 6, and FD&amp;C Blue #1. Contains soy.</paragraph>
                     </text>
                     <effectiveTime value="20180108"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="4c39225d-b6a5-5de2-e063-6294a90aa552"/>
                     <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
                     <title>INDICATIONS</title>
                     <text>
                        <paragraph>PNV-DHA + Docusate is a multivitamin/mineral prescription dietary supplement indicated for use in improving the nutritional status of women prior to conception, throughout pregnancy, and in the postnatal period for both lactating and nonlactating mothers.</paragraph>
                     </text>
                     <effectiveTime value="20180108"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="4c39225d-b6a6-5de2-e063-6294a90aa552"/>
                     <code code="34070-3" codeSystem="2.16.840.1.113883.6.1" displayName="CONTRAINDICATIONS SECTION"/>
                     <title>CONTRAINDICATIONS</title>
                     <text>
                        <paragraph>This product is contraindicated in patients with a known hypersensitivity to any of the ingredients.</paragraph>
                     </text>
                     <effectiveTime value="20180108"/>
                  </section>
               </component>
            </section>
