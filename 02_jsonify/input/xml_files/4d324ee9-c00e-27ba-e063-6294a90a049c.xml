         <component>
            <section ID="ID_c359819a-7db6-426d-825d-f4428668a3d1">
               <id root="4d324ee9-c010-27ba-e063-6294a90a049c"/>
               <code code="34089-3" codeSystem="2.16.840.1.113883.6.1" displayName="DESCRIPTION SECTION"/>
               <title>DESCRIPTION</title>
               <text>
                  <paragraph>Fluorometholone ophthalmic suspension, USP, 0.1% is a sterile, topical anti-inflammatory agent for ophthalmic use.</paragraph>
                  <paragraph>
                     <content styleCode="bold">Chemical Name</content>
                  </paragraph>
                  <paragraph>Fluorometholone: 9-Fluoro-11β,17-dihydroxy-6α-methylpregna-1,4-diene-3,20-dione.</paragraph>
                  <paragraph>
                     <content styleCode="bold">Structural Formula</content>
                  </paragraph>
                  <paragraph>
                     <renderMultiMedia ID="id-1899737893" referencedObject="ID_60724702-7e1a-440d-ae59-3546067ba67a"/>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Contains</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Active:</content>Fluorometholone 0.1%.
 
  <content styleCode="bold">Preservative:</content> Benzalkonium chloride 0.004%.
 
  <content styleCode="bold">Inactives:</content>Edetate disodium dihydrate, polysorbate 80, polyvinyl alcohol 1.4%, sodium chloride, sodium hydroxide to adjust pH (6.2 to 7.5), sodium phosphate dibasic (anhydrous), sodium phosphate monobasic (monohydrate), and water for injection. It has an osmolality range of 290 to 350 mOsm/kg.

 </paragraph>
               </text>
               <effectiveTime value="20250327"/>
               <component>
                  <observationMedia ID="ID_60724702-7e1a-440d-ae59-3546067ba67a">
                     <text>chemstr</text>
                     <value mediaType="image/jpeg" xsi:type="ED">
                        <reference value="image-01.jpg"/>
                     </value>
                  </observationMedia>
               </component>
            </section>
