         <component>
            <section ID="LINK_a89b81ba-f3c9-47ef-884d-5e071cdb5d01">
               <id root="a094a3c8-7f81-4ecd-8655-b7e686fa45bd"/>
               <code code="34084-4" codeSystem="2.16.840.1.113883.6.1" displayName="ADVERSE REACTIONS SECTION"/>
               <title>ADVERSE REACTIONS</title>
               <text>
                  <paragraph>Localized skin reactions such as redness, irritation, or rash may occur.</paragraph>
               </text>
               <effectiveTime value="20260227"/>
            </section>
         </component>
         <component>
            <section ID="LINK_d0f103a6-74ee-4a6e-904c-5f2784a308f0">
               <id root="ce0c4038-a930-4fc6-b477-0a59afd83c11"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DOSAGE AND ADMINISTRATION</title>
               <text>
                  <paragraph>For topical use only.<br/>
                     <br/>
Apply to the affected area 3 to 4 times daily or as directed by a healthcare provider.</paragraph>
               </text>
               <effectiveTime value="20260227"/>
            </section>
         </component>
         <component>
