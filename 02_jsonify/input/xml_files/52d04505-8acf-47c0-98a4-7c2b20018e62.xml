            <section ID="LINK_565622eb-adc7-4496-93b5-07199a92580d">
               <id root="565622eb-adc7-4496-93b5-07199a92580d"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Calcipotriene Cream 0.005%</title>
               <text>
