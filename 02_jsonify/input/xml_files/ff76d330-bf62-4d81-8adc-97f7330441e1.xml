            <section ID="id_link_d65f08de-fb4c-d8c2-e053-2a95a90a9576">
               <id root="6b0251e8-e706-4413-a3ae-26f6f1ee5af4"/>
               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>Inactive Ingredients</title>
               <text>
                  <paragraph>Butylated Hydroxytoluene, Citric Acid, Cetyl Alcohol, Cocamidopropyl Betaine, Disodium EDTA, Glycerin, Glyceryl Stearate SE, PEG-100 Stearate, Phenoxyethanol, Purified Water, Sodium Laureth Sulfate, Sodium Thiosulfate, Stearyl Alcohol, Triacetin, Xanthan Gum.</paragraph>
