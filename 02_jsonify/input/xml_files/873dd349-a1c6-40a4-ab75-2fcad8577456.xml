            <section ID="id_link_c95fa711-c2c4-81c7-e053-2995a90a5907">
               <id root="26e71c23-65f0-4811-a6a6-64dc8dc452e1"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>For Painful Musculoskeletal Conditions</paragraph>
               </text>
