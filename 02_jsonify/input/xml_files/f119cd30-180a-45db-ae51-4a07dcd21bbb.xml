            <section ID="b473ef0c-5b79-447f-9ff8-2e956ba2a620">
               <id root="dd2428a5-7626-4bad-b691-f7052f69930a"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="emphasis">
                        <content styleCode="bold">40 mEq in 20 mL</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="emphasis">
                        <content styleCode="bold">(2 mEq K<sup>+</sup> and 2 mEq CH<sub>3</sub>COO<sup>−</sup>/mL)</content>
                     </content>
                  </paragraph>
