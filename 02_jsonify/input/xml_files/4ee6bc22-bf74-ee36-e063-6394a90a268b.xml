               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>PACKAGE LABEL.PRINCIPAL DISPLAY PANEL</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Sodium Citrate and Citric Acid Oral Solution, USP - NDC 68999-868-51 - 15 mL Unit-Dose Cup Label</content>
                  </paragraph>
                  <paragraph>
