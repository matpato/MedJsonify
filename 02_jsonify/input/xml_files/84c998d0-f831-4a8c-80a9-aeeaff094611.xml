               <code code="34069-5" codeSystem="2.16.840.1.113883.6.1" displayName="HOW SUPPLIED SECTION"/>
               <title>HOW SUPPLIED</title>
               <text>
                  <paragraph>Vitavera™ chewable multivitamin tablets are supplied as:</paragraph>
                  <list listType="unordered" styleCode="Disk">
                     <item>
                        <content styleCode="bold">30 tablets per bottle</content>
                     </item>
                     <item>
                        <content styleCode="bold">NDC: 85477-513-30</content>
                     </item>
                     <item> Round chewable tablets, cherry flavored </item>
                  </list>
                  <paragraph>Dispense in a tight, light-resistant container as defined in the USP.</paragraph>
               </text>
               <effectiveTime value="20260421"/>
            </section>
         </component>
