            <section ID="i4i_dosage_form_strength_id_92c22f69-0898-408f-bebc-f45a750e24f6">
               <id root="22fd8e41-b8bb-48ee-8485-6afe3ce87601"/>
               <code code="43678-2" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE FORMS &amp; STRENGTHS SECTION"/>
               <title>3 DOSAGE FORMS AND STRENGTHS</title>
               <text>
                  <paragraph>1% clear dark blue, sterile, non-pyrogenic aqueous solution (isosulfan blue) for subcutaneous administration available as:</paragraph>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>5 mL single-dose vial</item>
                     <item>
                        <caption>•</caption>1 mL single-dose pre-filled syringe</item>
                     <item>
                        <caption>•</caption>3 mL single-dose pre-filled syringe</item>
                  </list>
               </text>
               <effectiveTime value="20251215"/>
               <excerpt>
                  <highlight>
                     <text>
                        <paragraph>1% clear dark blue, sterile, non-pyrogenic aqueous solution (isosulfan blue) for subcutaneous administration available as: (<linkHtml href="#i4i_dosage_form_strength_id_92c22f69-0898-408f-bebc-f45a750e24f6">3</linkHtml>)</paragraph>
                        <list listType="unordered">
                           <item>
                              <caption>•</caption>5 mL single-dose vial</item>
                           <item>
                              <caption>•</caption>1 mL single-dose pre-filled syringe</item>
                           <item>
                              <caption>•</caption>3 mL single-dose pre-filled syringe</item>
                        </list>
                     </text>
                  </highlight>
               </excerpt>
            </section>
