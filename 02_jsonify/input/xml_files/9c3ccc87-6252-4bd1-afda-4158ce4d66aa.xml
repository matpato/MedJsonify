         <component>
            <section ID="i4i_overdosage_id_66c91b20-5b0a-4875-8a2c-4c079ba87d37">
               <id root="5c1b81d8-875b-4a51-8491-b360f8642551"/>
               <code code="34088-5" codeSystem="2.16.840.1.113883.6.1" displayName="OVERDOSAGE SECTION"/>
               <title>10 OVERDOSAGE</title>
               <text>
                  <paragraph>Do not exceed indicated recommended dosage as overdosage levels have not been identified for isosulfan blue injection 1%.</paragraph>
               </text>
               <effectiveTime value="20170719"/>
