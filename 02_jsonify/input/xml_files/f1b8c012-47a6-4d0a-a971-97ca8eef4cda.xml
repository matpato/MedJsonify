         <component>
            <section ID="LINK_f07d7ec4-f0aa-4280-8cf7-af92b47f9d01">
               <id root="f07d7ec4-f0aa-4280-8cf7-af92b47f9d01"/>
               <code code="34089-3" codeSystem="2.16.840.1.113883.6.1" displayName="DESCRIPTION SECTION"/>
               <title/>
               <text>
                  <paragraph>Folvyris is an orally administered prescription folate product.</paragraph>
               </text>
               <effectiveTime value="20251212"/>
            </section>
         </component>
         <component>
            <section ID="LINK_9f90d1f1-60fa-4a2a-a33f-aa0088c101b8">
               <id root="9f90d1f1-60fa-4a2a-a33f-aa0088c101b8"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title/>
               <text>
                  <paragraph>Folvyris is for patients with unique nutritional needs requiring increased folate levels and Vitamin D supplementation due to Vitamin D deficiency.</paragraph>
               </text>
               <effectiveTime value="20251212"/>
            </section>
         </component>
         <component>
            <section ID="LINK_10dc12ea-065f-4ffc-97be-6b12f2db37e1">
               <id root="10dc12ea-065f-4ffc-97be-6b12f2db37e1"/>
               <code code="42232-9" codeSystem="2.16.840.1.113883.6.1" displayName="PRECAUTIONS SECTION"/>
               <title/>
               <text>
                  <paragraph>Folvyris should be administered under the supervision of a licensed medical practitioner.</paragraph>
               </text>
               <effectiveTime value="20251212"/>
            </section>
         </component>
         <component>
            <section ID="LINK_428e6b5b-6dec-4995-b3ba-5e7f2c88ce03">
