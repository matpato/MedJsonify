               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">MULTIVITAMIN WITH FLUORIDE</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="italics">Disclaimer: This drug has not been found by FDA to be safe</content>
                     <content styleCode="italics"/>
                     <content styleCode="italics">and effective, and this labeling has not been approved by FDA.</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Prescribing Information</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Each Fluoride Chewable Tablet Contains:</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">Supplement Facts</content>
                  </paragraph>
                  <paragraph>Dosage Size 1 Chewable Tablet</paragraph>
