               <code code="50741-8" codeSystem="2.16.840.1.113883.6.1" displayName="SAFE HANDLING WARNING SECTION"/>
               <title>
                  <content styleCode="bold">STORAGE</content>
               </title>
               <text>
                  <paragraph>Store at 20° to 25°C (68° to 77°F) [see USP Controlled 
  <br/>  Room Temperature]. Protect from freezing and excessive 
  <br/>  heat. Keep container tightly closed.
 </paragraph>
                  <paragraph>
                     <content styleCode="bold">KEEP THIS AND ALL MEDICATIONS OUT OF THE REACH OF CHILDREN.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20220316"/>
