               <title>Active Ingredient:</title>
               <text>
                  <paragraph>Active Ingredient: Stannous Fluoride 0.4% </paragraph>
                  <paragraph>Purpose: Anticavity</paragraph>
               </text>
               <effectiveTime value="19810401"/>
            </section>
