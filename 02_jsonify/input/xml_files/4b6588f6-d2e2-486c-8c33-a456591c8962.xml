               <code code="34069-5" codeSystem="2.16.840.1.113883.6.1" displayName="HOW SUPPLIED SECTION"/>
               <title>HOW SUPPLIED</title>
               <text>
                  <paragraph>Bottles of 30 Tablets (84460-910-30). Tablet is tan, oval.</paragraph>
               </text>
               <effectiveTime value="20260429"/>
            </section>
