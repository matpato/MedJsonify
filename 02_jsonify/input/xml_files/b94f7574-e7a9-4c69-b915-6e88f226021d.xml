            </section>
         </component>
         <component>
            <section ID="Lbb75c6eb-a715-4b8c-9e98-8a312038ec44">
               <id root="efe425b7-259a-e7b4-e053-2a95a90a54af"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>STORAGE</title>
               <text>
                  <paragraph>Store at 20° to 25°C (68° to 77°F) [see USP Controlled Room Temperature].</paragraph>
               </text>
               <effectiveTime value="20211112"/>
            </section>
         </component>
