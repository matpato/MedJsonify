         <component>
            <section ID="L0feffddd-8b9e-4314-a3a3-9cd9acd91265">
               <id root="3a1fb9b7-5484-4d73-e063-6394a90a5313"/>
               <code code="34070-3" codeSystem="2.16.840.1.113883.6.1" displayName="CONTRAINDICATIONS SECTION"/>
               <title>4 CONTRAINDICATIONS</title>
               <text>
                  <paragraph>None.</paragraph>
               </text>
               <effectiveTime value="20250717"/>
               <excerpt>
                  <highlight>
                     <text>
                        <paragraph>None.</paragraph>
