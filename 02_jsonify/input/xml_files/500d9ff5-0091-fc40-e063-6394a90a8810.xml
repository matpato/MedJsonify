               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Indications</title>
               <text>
                  <paragraph>PRO-SYS Professional is a self-applied dentrifice for prevention of tooth decay, orthodontic decalcification and hypersensitivity.</paragraph>
               </text>
               <effectiveTime value="20260201"/>
            </section>
