               <id root="4e6cb205-8181-11ca-e063-6394a90a6785"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <list listType="unordered">
                     <item>Do not swallow</item>
                     <item>For topical use only</item>
                     <item>As with all medications, keep out of reach of children</item>
                  </list>
               </text>
               <effectiveTime value="20260201"/>
            </section>
