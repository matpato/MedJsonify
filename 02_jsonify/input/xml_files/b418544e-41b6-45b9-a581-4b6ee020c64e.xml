            <section ID="e86822e4-9b2b-4c8b-b35d-cc0881470081">
               <id root="d7b07a42-7ce0-4d9d-8689-4e7dbffe6f74"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>Manganese Chloride<br/>Injection, USP</paragraph>
