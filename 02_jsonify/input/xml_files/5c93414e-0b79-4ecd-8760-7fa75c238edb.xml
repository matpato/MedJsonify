            <section ID="s1">
               <id root="20823139-9808-46cb-85fc-7a59e1606ab1"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Rx only</content>
                  </paragraph>
                  <paragraph>FOR DERMATOLOGIC USE ONLY.<br/>NOT FOR OPHTHALMIC USE.</paragraph>
               </text>
               <effectiveTime value="20260319"/>
            </section>
